#!/bin/sh
# Runs the tests before every push: pushes to main deploy, and the deploy doesn't run them.
# Enable once per clone with: git config core.hooksPath .githooks
# Skip on purpose with: git push --no-verify
cd "$(git rev-parse --show-toplevel)/web" || exit 1
npm test || {
  echo "pre-push: tests failed, push stopped (git push --no-verify skips this)" >&2
  exit 1
}
